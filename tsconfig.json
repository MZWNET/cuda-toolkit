{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "scripts/update-links/*.json",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
